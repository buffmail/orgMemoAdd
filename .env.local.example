# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the secret. For the deployed app,
# set the same variables in Vercel: Project -> Settings -> Environment Variables.
# .env.local is gitignored; never commit a real secret.
# ---------------------------------------------------------------------------

# Dropbox app -> Settings -> App key. Not a secret, already the default.
DROPBOX_APP_KEY=h1hbkipv02vmg9k

# Dropbox app -> Settings -> App secret ("Show"). REQUIRED. Server-side only;
# it is never sent to the browser.
DROPBOX_APP_SECRET=

# The org file that memos are appended to. For an App-folder app this is relative
# to the app's own folder, so /life.org is /앱/DavidNote/life.org in Dropbox.
# A Full-Dropbox app would use the absolute path instead.
DROPBOX_FILE_PATH=/life.org

# Optional. Pins the OAuth redirect URI, which Dropbox matches exactly. Leave
# empty locally. On Vercel set it to your production origin (no trailing slash),
# e.g. https://org-memo-add.vercel.app - otherwise a preview deployment sends its
# own unique URL, which is not registered, and linking fails there.
PUBLIC_BASE_URL=

# Optional shared passcode. If set, the memo box asks for it before writing.
# REQUIRED in practice whenever DROPBOX_REFRESH_TOKEN below is set, because that
# makes the deployed URL able to write without anyone linking a Dropbox account.
APP_PASSCODE=

# Optional. Leave empty to link Dropbox from the browser instead (recommended):
# the refresh token is then kept in an httpOnly cookie, so only browsers you
# linked can write. Set this only if you want every device to work without
# linking - and then set APP_PASSCODE too.
DROPBOX_REFRESH_TOKEN=
